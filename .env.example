# ---- Server ----
# 本地开发默认只监听 127.0.0.1；容器内需要设为 0.0.0.0
HOST=127.0.0.1
PORT=8787
# 只允许该来源跨域；Docker 部署经 nginx 同源代理，保持与访问地址一致即可
WEB_ORIGIN=http://localhost:5173

# MongoDB
# 直接运行（非 Docker）留空 = 复用本机 27017，否则启动内置 mongod（server/.data/mongodb）
# Docker 部署默认连接宿主机的 mongodb://host.docker.internal:27017/airoad
# 开启认证时填写，例如 mongodb://user:pass@host.docker.internal:27017/airoad?authSource=admin
MONGODB_URI=
MONGODB_DB=airoad
MONGO_PORT=27017

# ---- Docker 基础镜像 ----
# Docker Hub 不可达时换成可用的镜像站前缀；留空使用官方镜像
# NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine

# ---- AI ----
# 模型配置在网页「设置 → 模型连接」填写，保存在浏览器 localStorage，不需要写进 .env。
# 未配置时全站基础功能可用，AI 助手会显示未配置状态。

# ---- Mongo binary download (setup only) ----
MONGO_VERSION=7.0.14
# MONGO_DOWNLOAD_PROXY=http://127.0.0.1:7890
# 已有 mongod 时可指定路径，跳过下载
# MONGOD_BINARY=
